{
  "name": "berg-layout",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "layout",
    "resize",
    "responsive",
    "react",
    "angular"
  ],
  "license": "MIT",
  "scripts": {
    "audit-fix": "npx yarn-audit-fix",
    "build": "npx nx run-many --target=build && yarn prebuild-styles",
    "lint": "npx nx run-many --target=lint --all --parallel",
    "prebuild-styles": "npx nx run-many --target=prebuild-styles",
    "prettier": "npx prettier --write {apps,libs}/**/*",
    "publish-lib": "npx tsx ./scripts/publish-lib.ts",
    "serve": "npx nx serve demo",
    "test": "npx nx run-many --target=test --all --parallel --browsers=ChromeHeadlessNoSandbox"
  },
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
